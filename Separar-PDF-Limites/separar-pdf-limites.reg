Windows Registry Editor Version 5.00

; Clique no fundo da pasta (Background)
[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\Cortar PDF (1ª e última)]
@="Cortar PDF (1ª e última)"
"Icon"="C:\\MenuContexto\\Separar-PDF-Limites\\Icon.ico"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\Cortar PDF (1ª e última)\command]
@="\"C:\\MenuContexto\\Separar-PDF-Limites\\separar-pdf-limites.exe\" \"%V\""

; Clique em cima da pasta
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Cortar PDF (1ª e última)]
@="Cortar PDF (1ª e última)"
"Icon"="C:\\MenuContexto\\Separar-PDF-Limites\\Icon.ico"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Cortar PDF (1ª e última)\command]
@="\"C:\\MenuContexto\\Separar-PDF-Limites\\separar-pdf-limites.exe\" \"%1\""
