Windows Registry Editor Version 5.00

; Clique no fundo da pasta (Background)
[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\CombinarPDFs]
@="Combinar PDFs"
"Icon"="C:\\MenuContexto\\combinar-pdfs\\Icon1.ico"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\CombinarPDFs\command]
@="\"C:\\MenuContexto\\combinar-pdfs\\combinar-pdfs.exe\" \"%V\""

; Clique em cima da pasta
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\CombinarPDFs]
@="Combinar PDFs"
"Icon"="C:\\MenuContexto\\combinar-pdfs\\Icon1.ico"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\CombinarPDFs\command]
@="\"C:\\MenuContexto\\combinar-pdfs\\combinar-pdfs.exe\" \"%1\""
